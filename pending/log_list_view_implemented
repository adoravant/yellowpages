from django.views.generic import ListView
from django.shortcuts import get_object_or_404
from main.models import LeadFull
from .models import Event


class LeadEventListView(ListView):
    model = Event
    template_name = "sales/lead_events.html"
    context_object_name = "events"
    paginate_by = 50

    def get_queryset(self):
        self.lead = get_object_or_404(LeadFull, pk=self.kwargs["lead_id"])
        return (
            Event.objects
            .filter(lead=self.lead)
            .select_related("event_type")
            .order_by("-created_at")
        )

    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        context["lead"] = self.lead
        return context



# ==========================================
# sales/urls.py
# ==========================================

from django.urls import path
from .views import LeadEventListView

urlpatterns = [
    path(
        "lead/<int:lead_id>/events/",
        LeadEventListView.as_view(),
        name="lead-events",
    ),
]



