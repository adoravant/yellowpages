{% extends "base.html" %}

{% block content %}

<h2>Event Timeline - {{ lead.name }}</h2>

<table class="table table-striped table-sm">

    <thead>
        <tr>
            <th>Date</th>
            <th>Event</th>
            <th>Channel</th>
            <th>Metadata</th>
        </tr>
    </thead>

    <tbody>

    {% for event in events %}

        <tr>

            <td>
                {{ event.created_at }}
            </td>

            <td>
                {{ event.event_type.slug }}
            </td>

            <td>
                {{ event.channel|default:"-" }}
            </td>

            <td>
                <pre style="max-width:400px; white-space:pre-wrap;">
{{ event.metadata|default:"-" }}
                </pre>
            </td>

        </tr>

    {% empty %}

        <tr>
            <td colspan="4">
                No events recorded for this lead.
            </td>
        </tr>

    {% endfor %}

    </tbody>

</table>


{% if is_paginated %}

<div style="margin-top:20px;">

    {% if page_obj.has_previous %}
        <a href="?page={{ page_obj.previous_page_number }}">← Prev</a>
    {% endif %}

    &nbsp; Page {{ page_obj.number }} of {{ page_obj.paginator.num_pages }} &nbsp;

    {% if page_obj.has_next %}
        <a href="?page={{ page_obj.next_page_number }}">Next →</a>
    {% endif %}

</div>

{% endif %}

{% endblock %}



